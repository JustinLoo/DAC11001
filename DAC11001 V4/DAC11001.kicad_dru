(version 1)
(rule "Dense-area silk reference text 0.8mm"
	(condition "A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen'")
	(constraint text_height (min 0.79mm)))

(rule "APE spacing: 3.3V VDD 0.1524mm"
	(condition "A.NetName == '/ctrlpins/VDD' || B.NetName == '/ctrlpins/VDD'")
	(constraint clearance (min 0.1524mm)))

(rule "APE edge spacing: host 12V/GND vias 0.2mm"
	(condition "A.Type == 'Via' && (A.NetName == '/DC12V' || A.NetName == 'GND')")
	(constraint edge_clearance (min 0.2mm)))

(rule "APE powerin/ctrlpins: APE silk text 0.39mm / 0.08mm"
	(condition "(A.memberOfSheet('/powerin') || A.memberOfSheet('/ctrlpins') || A.memberOfSheet('/ctrlpins/i2c_spi_1') || A.memberOfSheet('/eeprom') || A.memberOfSheet('/pcie4x') || A.memberOfFootprint('R59') || A.memberOfFootprint('R60')) && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
	(constraint text_height (min 0.39mm))
	(constraint text_thickness (min 0.08mm)))

(rule "APE host strip spacing 0.15mm (host nets only)"
	(condition "(A.NetName == '/ctrlpins/*' || A.NetName == '/top_*/adum/VI*' || A.NetName == '/I2C_*' || A.NetName == 'GND' || A.NetName == '/powerin/DC12Vout' || A.NetName == '/DC3V3' || A.NetName == '/HSO*' || A.NetName == '/HSI*' || A.NetName == 'Net-(U2-*' || A.NetName == 'Net-(U21-*') && (B.NetName == '/ctrlpins/*' || B.NetName == '/top_*/adum/VI*' || B.NetName == '/I2C_*' || B.NetName == 'GND' || B.NetName == '/powerin/DC12Vout' || B.NetName == '/DC3V3' || B.NetName == '/HSO*' || B.NetName == '/HSI*' || B.NetName == 'Net-(U2-*' || B.NetName == 'Net-(U21-*')")
	(constraint clearance (min 0.15mm)))

(rule "APE host strip signal track width 0.152mm"
	(condition "A.Type == 'Track' && A.NetName != '/ctrlpins/VDD' && (A.NetName == '/ctrlpins/*' || A.NetName == '/top_*/adum/VI*' || A.NetName == '/I2C_*' || A.NetName == 'Net-(U2-*' || A.NetName == 'Net-(U21-*')")
	(constraint track_width (min 0.15mm) (opt 0.152mm)))

(rule "Shield isolation 0.5mm"
	(condition "A.NetName == '/SHIELD' && B.NetName != '/SHIELD'")
	(constraint clearance (min 0.5mm)))
